{
  "name": "elephant-pants",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run generate:domain-projections && bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run check:data-formats && npm run check:domain-drift && npm run check:projections && npm run build && node --test tests/*.test.mjs",
    "test:calendar-sync": "node --test tests/calendar-sync.test.mjs",
    "check:domain-drift": "node scripts/check-domain-drift.mjs",
    "check:data-formats": "node scripts/validate-data-formats.mjs",
    "generate:domain-projections": "node scripts/generate-domain-projections.mjs",
    "check:projections": "node scripts/generate-domain-projections.mjs --check",
    "sync:calendar": "node scripts/sync-google-calendar.mjs --apply",
    "sync:calendar:dry-run": "node scripts/sync-google-calendar.mjs --dry-run",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "js-yaml": "4.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Elephant Pants"
}
